# Environment variables for /retrospectool
#
# Copy this file to `.env.local` and fill in the values:
#   cp env.example .env.local
#
# `.env.local` is gitignored — NEVER commit real secrets. Keep this example file
# with placeholders / names only. `NEXT_PUBLIC_*` values are inlined into the client
# bundle and are public by design; everything else is server-only.

# --- Convex (backend / realtime DB) ---
# Both values are written automatically the first time you run `npm run convex:dev`.
CONVEX_DEPLOYMENT=
NEXT_PUBLIC_CONVEX_URL=

# --- Clerk (authentication) ---
# From your Clerk application dashboard -> API Keys.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
# NOTE: CLERK_JWT_ISSUER_DOMAIN is NOT set here. Configure it in the Convex dashboard
# (Settings -> Environment Variables); it is read by convex/auth.config.js.

# --- AI (action-item generation, optional) ---
# Read implicitly by the Vercel AI SDK providers (@ai-sdk/openai / @ai-sdk/anthropic).
# Only required if you use the AI action-item feature.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# --- ElevenLabs (text-to-speech, optional) ---
# Only required if you use the note speech / text-to-speech feature.
ELEVEN_LABS_API_KEY=
